{
	"name" : "dmk/dmkclub",
	"description" : "DMKClub",
	"homepage" : "https://github.com/DMKEBUSINESSGMBH/DMKClub.git",
	"license" : "OSL-3.0",
	"authors" : [{
			"name" : "DMK E-BUSINESS GmbH",
			"homepage" : "http://www.dmk-ebusiness.de"
		}
	],
	"autoload" : {
		"psr-4" : {
			"DMKClub\\Bundle\\" : "src/DMKClub/Bundle/"
		}
	},
	"repositories" : [{
			"type" : "composer",
			"url" : "https://packagist.oroinc.com"
		}
	],
	"require" : {
		"php" : ">=8.4",
		"qipsius/tcpdf-bundle" : "^3.0.5",
		"tecnickcom/tcpdf" : "^6.11",
		"digitick/sepa-xml" : "^3.2",
		"oro/crm" : "~6.1.0"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.64",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^11.5"
	},
	"config": {
		"vendor-dir": ".Build/vendor",
		"bin-dir": ".Build/bin",
		"allow-plugins": {
			"symfony/flex": true,
			"symfony/runtime": true
		}
	},
	"minimum-stability" : "dev",
	"prefer-stable" : true
}
